<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buu.oa.mapper.MeetingReservationMapper">

    <!-- 基础结果映射 -->
    <resultMap id="ReservationResultMap" type="com.buu.oa.entity.MeetingReservation">
        <id column="id" property="id"/>
        <result column="reservation_no" property="reservationNo"/>
        <result column="room_id" property="roomId"/>
        <result column="emp_id" property="empId"/>
        <result column="meeting_title" property="meetingTitle"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="description" property="description"/>
        <result column="remind_status" property="remindStatus"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="room_name" property="roomName"/>
        <result column="emp_name" property="empName"/>
    </resultMap>

    <!--
        查询指定月份的预约列表
        业务逻辑：联表获取会议室名称和预约人姓名，按开始时间升序排列
    -->
    <select id="selectMonthlyReservation" resultMap="ReservationResultMap">
        SELECT r.*, m.room_name, e.name AS emp_name
        FROM meeting_reservation r
        LEFT JOIN meeting_room m ON r.room_id = m.id
        LEFT JOIN emp_employee e ON r.emp_id = e.id
        WHERE r.status = 1
        AND YEAR(r.start_time) = #{year}
        AND MONTH(r.start_time) = #{month}
        <if test="roomId != null">
            AND r.room_id = #{roomId}
        </if>
        ORDER BY r.start_time ASC
    </select>

    <!--
        查询时间冲突的预约记录
        业务逻辑：冲突判断规则 - 新预约开始时间 < 已有预约结束时间 且 新预约结束时间 > 已有预约开始时间
        排除已取消的预约和指定ID的预约（用于修改场景）
    -->
    <select id="selectConflictReservation" resultType="com.buu.oa.entity.MeetingReservation">
        SELECT id, reservation_no, room_id, start_time, end_time
        FROM meeting_reservation
        WHERE room_id = #{roomId}
        AND status = 1
        AND start_time <![CDATA[<]]> #{endTime}
        AND end_time <![CDATA[>]]> #{startTime}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!--
        新增会议预约
        业务逻辑：插入预约单基础信息，状态默认为有效
    -->
    <insert id="insertReservation" parameterType="com.buu.oa.entity.MeetingReservation" useGeneratedKeys="true" keyProperty="entity.id">
        INSERT INTO meeting_reservation (reservation_no, room_id, emp_id, meeting_title, start_time, end_time, description, remind_status, status)
        VALUES (#{entity.reservationNo}, #{entity.roomId}, #{entity.empId}, #{entity.meetingTitle},
                #{entity.startTime}, #{entity.endTime}, #{entity.description}, 0, 1)
    </insert>

</mapper>