<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buu.oa.mapper.EmpEmployeeMapper">

    <!-- 基础结果映射 -->
    <resultMap id="EmployeeResultMap" type="com.buu.oa.entity.EmpEmployee">
        <id column="id" property="id"/>
        <result column="emp_no" property="empNo"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="dept_id" property="deptId"/>
        <result column="position" property="position"/>
        <result column="entry_date" property="entryDate"/>
        <result column="status" property="status"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="dept_name" property="deptName"/>
    </resultMap>

    <!--
        查询员工列表
        业务逻辑：联表部门表获取部门名称，支持按状态筛选，按入职日期倒序
    -->
    <select id="selectEmployeeList" resultMap="EmployeeResultMap">
        SELECT e.*, d.dept_name
        FROM emp_employee e
        LEFT JOIN sys_dept d ON e.dept_id = d.id
        <where>
            <if test="status != null">
                AND e.status = #{status}
            </if>
        </where>
        ORDER BY e.entry_date DESC
    </select>

    <!--
        根据ID查询员工详情
        业务逻辑：联表返回部门名称，用于详情弹窗展示
    -->
    <select id="selectEmployeeById" resultMap="EmployeeResultMap">
        SELECT e.*, d.dept_name
        FROM emp_employee e
                 LEFT JOIN sys_dept d ON e.dept_id = d.id
        WHERE e.id = #{id}
    </select>

</mapper>