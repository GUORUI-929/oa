<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buu.oa.mapper.ExpenseReportItemMapper">

    <!--
        批量插入报销明细
        业务逻辑：一次性插入同一张报销单的所有明细条目
    -->
    <insert id="batchInsertItems" parameterType="java.util.List">
        INSERT INTO expense_report_item (report_id, item_name, amount, expense_date, remark)
        VALUES
        <foreach collection="itemList" item="item" separator=",">
            (#{item.reportId}, #{item.itemName}, #{item.amount}, #{item.expenseDate}, #{item.remark})
        </foreach>
    </insert>

</mapper>