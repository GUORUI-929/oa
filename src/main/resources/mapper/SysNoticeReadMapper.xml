<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.buu.oa.mapper.SysNoticeReadMapper">

    <!-- 统计用户已读公告数量 -->
    <select id="countReadByUserId" resultType="java.lang.Long">
        SELECT COUNT(id)
        FROM sys_notice_read
        WHERE user_id = #{userId}
    </select>

    <!-- 检查单条公告是否已读 -->
    <select id="checkRead" resultType="java.lang.Integer">
        SELECT COUNT(id)
        FROM sys_notice_read
        WHERE notice_id = #{noticeId} AND user_id = #{userId}
    </select>

</mapper>